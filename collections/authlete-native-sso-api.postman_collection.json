      "item": [
        {
          "id": "07fcf63f-795c-4c6f-8cec-cb200fbfda82",
          "name": "Native SSO Processing",
          "request": {
            "name": "Native SSO Processing",
            "description": {
              "content": "This API should be called by the implementation of a token endpoint to generate the ID token and\ntoken response that comply with [OpenID Connect Native SSO for Mobile Apps 1.0](https://openid.net/specs/openid-connect-native-sso-1_0.html)\n(Native SSO) when Authlete’s `/auth/token` response indicates `action = NATIVE_SSO` (after you validate\nthe session id and verify or generate the device secret as required by the flow). The token endpoint\nimplementation should retrieve the value of `action` from the response and take the following steps\naccording to the value.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                ":serviceId",
                "nativesso"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "serviceId",
                  "description": "(Required) A service ID."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessToken\": \"<string>\",\n  \"deviceSecret\": \"<string>\",\n  \"refreshToken\": \"<string>\",\n  \"sub\": \"<string>\",\n  \"claims\": \"<string>\",\n  \"idtHeaderParams\": \"<string>\",\n  \"idTokenAudType\": \"<string>\",\n  \"deviceSecretHash\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
