{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authlete Authorization Endpoint API",
    "version": "3.0.16"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authorization Endpoint",
        "type": "folder"
      },
      "items": [
