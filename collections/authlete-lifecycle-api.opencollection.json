{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authlete Authorization Endpoint Lifecycle API",
    "version": "3.0.16"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Lifecycle",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.authlete.com/api/lifecycle/healthcheck",
            "params": [
              {
                "name": "extended",
                "value": "",
                "type": "query",
                "description": "If `true`, perform extended health checks (e.g. database connectivity).\n"
              }
            ]
          },
          "docs": "Perform a health check of the server.\n"
        }
      ]
    }
  ],
  "bundled": true
}